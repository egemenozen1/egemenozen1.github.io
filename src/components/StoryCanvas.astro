---
// One set of points, three shapes:
//   0 · a DNA double helix (the lab)
//   1 · the two strands become the two forecast lines of the TFT experiment (real data)
//   2 · the points regroup into the EGO AI Studio office: owner → director → six specialists → gate
// Scroll position (from the story steps) decides the blend.
import { forecast } from '../data/forecast';
const tft = forecast.data.map((row) => row.tft);
const per = forecast.data.map((row) => row.per);
---
<div class="story-visual" aria-hidden="true">
  <canvas data-story data-series={JSON.stringify({ tft, per })}></canvas>
  <p class="story-caption"><span data-cap>DNA · two strands, paired</span><b data-capr>01 / 03</b></p>
</div>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-story]');
  const ctx = canvas?.getContext('2d');
  const steps = document.querySelector('[data-steps]');
  if (canvas && ctx && steps && 'IntersectionObserver' in window && 'ResizeObserver' in window) {
    const { tft, per } = JSON.parse(canvas.dataset.series || '{}') as { tft: number[]; per: number[] };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const PAIRS = 56, N = PAIRS * 2;
    const hubs = [
      { id: 'owner', label: 'owner', x: 0.5, y: 0.1 },
      { id: 'director', label: 'director', x: 0.5, y: 0.32 },
      { id: 'research', label: 'research', x: 0.14, y: 0.6 },
      { id: 'engineer', label: 'engineer', x: 0.32, y: 0.66 },
      { id: 'ux', label: 'product & ux', x: 0.5, y: 0.7 },
      { id: 'qa', label: 'qa & security', x: 0.68, y: 0.66 },
      { id: 'data', label: 'data', x: 0.86, y: 0.6 },
      { id: 'career', label: 'career', x: 0.1, y: 0.86 },
      { id: 'gate', label: 'human gate', x: 0.72, y: 0.9 },
    ];
    let W = 0, H = 0, t = 0, progress = 0, shown = 0, last = 0;
    let visible = false, measure = true, dirty = true, frame = 0;
    const cap = document.querySelector('[data-cap]'), capr = document.querySelector('[data-capr]');
    const captions = ['DNA · two strands, paired', 'Two strands → two forecasts: TFT vs persistence', 'Points → people and agents: a governed office'];
    const root = document.documentElement;
    let theme: string | undefined;
    let paletteUntil = 0;
    let palette = { fg: '', acc: '', sub: '' };
    const colors = (now: number) => {
      if (!palette.fg || theme !== root.dataset.theme) {
        theme = root.dataset.theme;
        paletteUntil = now + 650;
      }
      if (paletteUntil) {
        const style = getComputedStyle(root);
        palette = { fg: style.getPropertyValue('--fg').trim(), acc: style.getPropertyValue('--acc').trim(), sub: style.getPropertyValue('--sub').trim() };
        if (now >= paletteUntil) paletteUntil = 0;
      }
      return palette;
    };

    // Interpolate a 24-point series to PAIRS points.
    const sample = (a: number[], k: number) => { const f = (k / (PAIRS - 1)) * (a.length - 1), i = Math.floor(f), r = f - i; return a[i] + ((a[Math.min(a.length - 1, i + 1)] - a[i]) * r); };

    const helix = (i: number) => {
      const k = i >> 1, s = i & 1;
      const ang = k * 0.34 + t * 0.55 + s * Math.PI;
      const R = Math.min(W * 0.2, 150);
      return { x: W / 2 + Math.cos(ang) * R, y: H * 0.06 + (k / (PAIRS - 1)) * H * 0.88, z: Math.sin(ang) };
    };
    const chart = (i: number) => {
      const k = i >> 1, s = i & 1, v = s ? sample(per, k) : sample(tft, k);
      const x = W * 0.08 + (k / (PAIRS - 1)) * W * 0.84;
      const y = H * 0.85 - ((v - 0.45) / 1.05) * H * 0.7;
      return { x, y, z: s ? -0.2 : 0.4 };
    };
    const office = (i: number) => {
      const h = hubs[i % hubs.length], n = Math.floor(i / hubs.length), ring = 9 + (n % 3) * 7, a = n * 2.4 + t * 0.35 * (n % 2 ? 1 : -1);
      return { x: h.x * W + Math.cos(a) * ring, y: h.y * H + Math.sin(a) * ring * 0.8, z: n === 0 ? 1 : 0 };
    };

    const resize = () => {
      const r = canvas.getBoundingClientRect(); W = r.width; H = r.height;
      const dpr = Math.min(devicePixelRatio || 1, 1.75, Math.sqrt(1.2e6 / Math.max(1, W * H)));
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const smooth = (x: number) => x * x * (3 - 2 * x);
    const weights = (p: number) => {
      // p in [0, 2]: 0 helix, 1 chart, 2 office
      const a = smooth(Math.min(1, Math.max(0, p))), b = smooth(Math.min(1, Math.max(0, p - 1)));
      return [1 - a, a * (1 - b), b];
    };

    const draw = (now: number) => {
      const { fg, acc, sub } = colors(now);
      const [w0, w1, w2] = weights(shown);
      const l0 = w0 ** 3, l1 = w1 ** 4, l2 = w2 ** 3; // connecting lines fade fast mid-morph so the shapes stay legible
      ctx.clearRect(0, 0, W, H);
      const pts = Array.from({ length: N }, (_, i) => {
        const h = w0 ? helix(i) : zero, c = w1 ? chart(i) : zero, o = w2 ? office(i) : zero;
        return { x: h.x * w0 + c.x * w1 + o.x * w2, y: h.y * w0 + c.y * w1 + o.y * w2, z: h.z * w0 + c.z * w1 + o.z * w2, s: i & 1 };
      });
      // helix rungs
      if (l0 > 0.02) {
        ctx.globalAlpha = 0.35 * l0; ctx.strokeStyle = fg; ctx.lineWidth = 1.2; ctx.beginPath();
        for (let k = 0; k < PAIRS; k++) { const a = pts[k * 2], b = pts[k * 2 + 1]; ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); }
        ctx.stroke();
      }
      // chart lines + axis
      if (l1 > 0.02) {
        for (const s of [0, 1]) {
          ctx.globalAlpha = l1; ctx.strokeStyle = s ? acc : fg; ctx.lineWidth = s ? 2 : 2.6; ctx.setLineDash(s ? [6, 6] : []); ctx.beginPath();
          for (let k = 0; k < PAIRS; k++) { const p = pts[k * 2 + s]; k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); }
          ctx.stroke();
        }
        ctx.setLineDash([]); ctx.globalAlpha = 0.5 * l1; ctx.strokeStyle = sub; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(W * 0.08, H * 0.88); ctx.lineTo(W * 0.92, H * 0.88); ctx.stroke();
        ctx.globalAlpha = l1; ctx.fillStyle = sub; ctx.font = '12px "Geist Mono Variable", monospace';
        ctx.fillText('1h', W * 0.08, H * 0.93); ctx.textAlign = 'right'; ctx.fillText('24h ahead', W * 0.92, H * 0.93); ctx.textAlign = 'left';
        ctx.fillStyle = fg; ctx.fillText('— TFT', W * 0.08, H * 0.08); ctx.fillStyle = acc; ctx.fillText('- - persistence', W * 0.08 + 64, H * 0.08);
      }
      // office edges + labels
      if (l2 > 0.02) {
        const P = (id: string) => { const h = hubs.find((x) => x.id === id)!; return [h.x * W, h.y * H]; };
        ctx.globalAlpha = 0.45 * l2; ctx.strokeStyle = fg; ctx.lineWidth = 1.2; ctx.beginPath();
        const [ox, oy] = P('owner'), [dx, dy] = P('director');
        ctx.moveTo(ox, oy); ctx.lineTo(dx, dy);
        for (const id of ['research', 'engineer', 'ux', 'qa', 'data', 'career']) { const [x, y] = P(id); ctx.moveTo(dx, dy); ctx.lineTo(x, y); }
        ctx.stroke();
        const [gx, gy] = P('gate'); ctx.strokeStyle = acc; ctx.setLineDash([5, 5]); ctx.beginPath(); ctx.moveTo(dx, dy); ctx.lineTo(gx, gy); ctx.moveTo(gx, gy); ctx.lineTo(ox + 40, oy); ctx.stroke(); ctx.setLineDash([]);
        ctx.globalAlpha = l2; ctx.font = '600 13px "Bricolage Grotesque Variable", sans-serif'; ctx.textAlign = 'center';
        for (const h of hubs) { ctx.fillStyle = h.id === 'gate' ? acc : fg; ctx.fillText(h.label, h.x * W, h.y * H + (h.y < 0.2 ? -18 : 30)); }
        ctx.textAlign = 'left';
      }
      // points
      for (const p of pts) {
        const r = 2.2 + Math.max(0, p.z) * 2.4 * (w0 + w2 * 0.6) + w1 * 0.6;
        ctx.globalAlpha = 0.45 + 0.55 * ((p.z + 1) / 2) * w0 + (w1 + w2) * 0.5;
        ctx.fillStyle = p.s ? acc : fg;
        ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, 6.283); ctx.fill();
      }
      ctx.globalAlpha = 1;
      const idx = shown < 0.5 ? 0 : shown < 1.5 ? 1 : 2;
      if (cap && cap.textContent !== captions[idx]) { cap.textContent = captions[idx]; capr!.textContent = `0${idx + 1} / 03`; }
    };

    const zero = { x: 0, y: 0, z: 0 };
    const requestDraw = () => {
      if (visible && !document.hidden && !frame) frame = requestAnimationFrame(loop);
      else if (!visible || document.hidden) {
        cancelAnimationFrame(frame);
        frame = 0;
        last = 0;
      }
    };
    const loop = (now: number) => {
      frame = 0;
      if (measure) { resize(); measure = false; }
      if (dirty) {
        const rect = steps.getBoundingClientRect();
        const fraction = (innerHeight / 2 - rect.top) / Math.max(1, rect.height);
        progress = Math.min(2, Math.max(0, fraction * 3 - 0.5));
        dirty = false;
      }
      if (reduce.matches) {
        shown = Math.round(progress);
        t = 0;
        draw(now);
        return;
      }
      const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
      last = now;
      t += dt;
      shown = Math.abs(progress - shown) < 0.001 ? progress : shown + (progress - shown) * Math.min(1, dt * 7);
      draw(now);
      requestDraw();
    };
    const updateProgress = () => { dirty = true; requestDraw(); };
    const observer = new ResizeObserver(() => { measure = true; updateProgress(); });
    observer.observe(canvas);
    observer.observe(steps);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) addEventListener('scroll', updateProgress, { passive: true });
      else removeEventListener('scroll', updateProgress);
      updateProgress();
    }).observe(canvas);
    new MutationObserver(requestDraw).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    document.addEventListener('visibilitychange', updateProgress);
    reduce.addEventListener('change', () => { last = 0; updateProgress(); });
  }
</script>
