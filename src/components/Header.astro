---
import { nav, site } from '../config/site';
---
<a href="#main" class="skip">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Egemen Özen, home"><span class="brand-mark" aria-hidden="true">eö</span><span class="brand-name">Egemen Özen</span></a>
    <nav class="nav-links" aria-label="Primary navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="nav-cta" href="/#contact">Contact</a>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" data-open="false" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <button class="close" type="button">Close</button>
  <nav aria-label="Mobile navigation">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="/#contact">Contact</a>
  </nav>
  <p class="eyebrow"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a> · Berlin, Germany</p>
</div>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  // Scroll handler only reads scrollY (no layout). Tone comes from an IntersectionObserver
  // watching a 1px band just under the header.
  let lastY = scrollY, queued = false;
  const sync = () => {
    queued = false;
    if (!header) return;
    const y = scrollY;
    header.dataset.scrolled = String(y > 8);
    if (y > lastY + 2 && y > 640) header.dataset.hidden = 'true';
    else if (y < lastY - 2 || y <= 640) header.dataset.hidden = 'false';
    lastY = y;
  };
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(sync); } }, { passive: true });
  sync();
  if (header) {
    const under = new Set<Element>();
    let io: IntersectionObserver | undefined;
    const watch = () => {
      io?.disconnect(); under.clear();
      const h = header.offsetHeight;
      io = new IntersectionObserver((entries) => {
        for (const e of entries) e.isIntersecting ? under.add(e.target) : under.delete(e.target);
        header.dataset.tone = under.size ? 'night' : 'paper';
      }, { rootMargin: `-${h}px 0px -${Math.max(0, innerHeight - h - 1)}px 0px` });
      document.querySelectorAll('.night').forEach((el) => io!.observe(el));
    };
    watch();
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(watch, 200); });
  }
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('mobile-menu');
  const close = menu?.querySelector<HTMLButtonElement>('.close');
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', String(open));
    if (open) { menu.hidden = false; requestAnimationFrame(() => { menu.dataset.open = 'true'; close?.focus(); }); }
    else { menu.dataset.open = 'false'; setTimeout(() => { menu.hidden = true; }, 260); btn.focus(); }
    document.body.style.overflow = open ? 'hidden' : '';
    const lenis = (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;
    open ? lenis?.stop() : lenis?.start();
  };
  btn?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => {
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', 'false'); menu.dataset.open = 'false'; menu.hidden = true; document.body.style.overflow = '';
  }));
  menu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
    if (e.key !== 'Tab') return;
    const f = [...menu.querySelectorAll<HTMLElement>('a, button')];
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
</script>
