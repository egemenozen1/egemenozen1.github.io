---
import { Image } from 'astro:assets';
import shot from '../assets/work/marketpulse-portfolio.png';
// Hotspot positions are percentages of the 1422×1000 screenshot.
const spots = [
  { x: 20.8, y: 20, title: 'Recorded, not assumed', text: 'The headline reads “recorded holdings value” and says that sample records affect totals. Sample data is flagged in the data model and never presented as live.' },
  { x: 28.9, y: 33.9, title: 'Review flags, not silent fills', text: 'Positions with stale (older than three days) or missing prices raise a data-review flag. A missing value stays empty instead of being estimated.' },
  { x: 48.6, y: 55.1, title: 'Every number keeps its receipt', text: 'Prices carry their source and observation time — here “Latest recorded · Fictional design fixture” with a UTC timestamp.' },
  { x: 53.7, y: 80, title: 'Gaps stay gaps', text: 'The chart breaks its line across gaps longer than 36 hours instead of interpolating, and states that it is not portfolio performance.' },
  { x: 91.1, y: 46, title: 'Known value only', text: 'Allocation is computed on known EUR value, so a position without a price cannot distort concentration.' },
];
---
<div class="instrument" data-inspector>
  <div class="instrument-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>provenance inspector · select a marker</span>
    <span>fixture data</span>
  </div>
  <div class="inspect-figure">
    <Image src={shot} widths={[640, 960, 1440]} sizes="(max-width: 1080px) 100vw, 56vw" quality={78} loading="lazy" alt="MarketPulse My Portfolio workspace with recorded holdings value, P&L figures, a BTC price-history chart and an allocation panel, using fictional fixture data." />
    {spots.map((s, i) => (
      <button class="hotspot" type="button" style={`left:${s.x}%;top:${s.y}%`} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Marker ${i + 1}: ${s.title}`} data-i={i}>{i + 1}</button>
    ))}
  </div>
  <div class="inspect-panel" aria-live="polite">
    <span class="k" data-k>01 / 05</span>
    <div><h4 data-t>{spots[0].title}</h4><p data-x>{spots[0].text}</p></div>
  </div>
  <script type="application/json" data-spots set:html={JSON.stringify(spots)} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-inspector]').forEach((root) => {
    const spots: { title: string; text: string }[] = JSON.parse(root.querySelector('[data-spots]')?.textContent || '[]');
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.hotspot')];
    const k = root.querySelector('[data-k]')!, t = root.querySelector('[data-t]')!, x = root.querySelector('[data-x]')!;
    btns.forEach((b) => b.addEventListener('click', () => {
      const i = Number(b.dataset.i);
      btns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      k.textContent = `${String(i + 1).padStart(2, '0')} / ${String(spots.length).padStart(2, '0')}`;
      t.textContent = spots[i].title; x.textContent = spots[i].text;
    }));
  });
</script>
