---
import { site } from '../config/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-orbit" aria-hidden="true"><span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span><span class="ring r4"></span><span class="orbit-line"></span><span class="orbit-point"></span></div>
  <div class="container hero-inner">
    <div class="hero-main">
      <span class="eyebrow">Data + AI + Product Builder</span>
      <h1 id="hero-title"><span class="hero-title-line">Building intelligent</span> <em>digital products.</em></h1>
      <p class="hero-description">I'm Egemen Özen, a Berlin-based data analytics professional working across Python, applied AI, and product development.</p>
      <div class="actions"><a class="btn btn-primary" href="#work">Explore My Work <span class="arrow" aria-hidden="true">↗</span></a><a class="btn btn-outline" href={site.github} target="_blank" rel="noopener noreferrer">View GitHub <span class="arrow" aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-foot"><span>Berlin, Germany</span><a href="#work">Scroll to explore <span aria-hidden="true">↓</span></a></div>
  </div>
</section>
