---
// Hero instrument: scattered inputs pass three gates and leave as clean, labelled lanes.
// Inputs that fail verification are held at the gate. A generative simulation, not project data.
const gates = [
  { at: 0.3, n: '01', label: 'Ingest', note: 'noisy inputs' },
  { at: 0.56, n: '02', label: 'Reason', note: 'models & agents' },
  { at: 0.76, n: '03', label: 'Verify', note: 'gates & tests' },
];
const lanes = ['cited source', 'passing test', 'baseline beaten', 'stated limit', 'owner approval'];
const laneTop = (i: number) => 24 + i * (62 / (lanes.length - 1));
---
<div class="signal" data-signal>
  <canvas role="img" aria-label="Animated illustration: scattered data points flow through three gates — ingest, reason and verify — and leave as five clean lanes labelled cited source, passing test, baseline beaten, stated limit and owner approval. Points that fail verification are held at the last gate."></canvas>
  <div class="signal-gates" aria-hidden="true">
    {gates.map((g) => <span class="gate-label" style={`left:${g.at * 100}%`}><b>{g.n}</b>{g.label}<span> · {g.note}</span></span>)}
    <div class="lane-tags">
      {lanes.map((l, i) => <span class="lane-tag" style={`top:${laneTop(i)}%`}>✓ {l}</span>)}
    </div>
  </div>
  <p class="signal-readout" aria-hidden="true">
    <span>live simulation</span>
    <span>through gate <b data-c="seen">0</b></span>
    <span>passed <b data-c="pass">0</b></span>
    <span class="held">held for review <b data-c="held">0</b></span>
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-signal]');
  const canvas = root?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');
  if (root && canvas && ctx) {
    const G1 = 0.3, G2 = 0.56, G3 = 0.76;
    const LANES = 5;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0, dpr = 1, laneY: number[] = [], P: Particle[] = [], laneGrad: CanvasGradient | null = null;
    let px = -999, py = -999, running = false, visible = true, last = 0;
    const counts = { seen: 0, pass: 0, held: 0 };
    const out = Object.fromEntries([...root.querySelectorAll<HTMLElement>('[data-c]')].map((e) => [e.dataset.c, e]));
    const css = getComputedStyle(document.documentElement);
    const INK = css.getPropertyValue('--ink').trim() || '#141412';
    const SIG = css.getPropertyValue('--signal').trim() || '#ff4f12';

    type Particle = { x: number; y: number; v: number; lane: number; bad: boolean; off: number; dead: boolean; vy: number; a: number; counted: boolean; ph: number };
    const rnd = Math.random;
    const spawn = (p: Partial<Particle> = {}, initial = false): Particle => ({
      x: initial ? rnd() * W * 1.05 - W * 0.05 : -rnd() * W * 0.12,
      y: H * (0.14 + rnd() * 0.8), v: 0.45 + rnd() * 0.95, lane: (rnd() * LANES) | 0,
      bad: rnd() < 0.12, off: (rnd() < 0.5 ? -1 : 1) * (9 + rnd() * 16), dead: false, vy: 0, a: 1, counted: false, ph: rnd() * 6.28, ...p,
    });

    const resize = () => {
      const r = root.getBoundingClientRect();
      W = r.width; H = r.height; // Cap the backing store at ~1.3 MP so large/high-DPI monitors don't multiply the per-frame cost.
      dpr = Math.max(0.75, Math.min(devicePixelRatio || 1, W > 1000 ? 1.25 : 1.5, Math.sqrt(1.3e6 / Math.max(1, W * H))));
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      laneY = Array.from({ length: LANES }, (_, i) => H * (0.24 + i * (0.62 / (LANES - 1))));
      laneGrad = ctx.createLinearGradient(W * G2, 0, W, 0);
      laneGrad.addColorStop(0, 'rgba(20,20,18,0)'); laneGrad.addColorStop(0.5, 'rgba(20,20,18,0.09)'); laneGrad.addColorStop(1, 'rgba(20,20,18,0.2)');
      const n = Math.max(170, Math.min(820, Math.round(W * 0.56)));
      P = Array.from({ length: n }, () => {
        const p = spawn({}, true);
        if (p.x > W * G3) { p.bad = false; p.counted = true; p.y = laneY[p.lane]; }
        return p;
      });
      if (reduce) { for (let i = 0; i < 700; i++) step(1); draw(); }
    };

    const step = (dt: number) => {
      const sp = Math.max(0.75, W / 1300);
      for (let i = 0; i < P.length; i++) {
        const p = P[i];
        if (p.dead) {
          p.vy += 0.07 * dt; p.y += p.vy * dt; p.x += p.v * 0.12 * dt; p.a -= 0.011 * dt;
          if (p.a <= 0 || p.y > H + 10) P[i] = spawn();
          continue;
        }
        const t = p.x / W;
        if (t < G1) {
          p.y += (rnd() - 0.5) * 2.6 * dt + Math.sin(p.x * 0.018 + p.ph) * 0.35 * dt;
        } else if (t < G3) {
          const k = (t - G1) / (G3 - G1);
          const target = laneY[p.lane] + (p.bad ? p.off * k : 0);
          p.y += (target - p.y) * (0.01 + 0.09 * k * k) * dt + (rnd() - 0.5) * 1.4 * (1 - k) * dt;
        } else {
          if (!p.counted) {
            p.counted = true; counts.seen++;
            if (p.bad) { p.dead = true; p.vy = -0.4; counts.held++; continue; }
            counts.pass++;
          }
          p.y += (laneY[p.lane] - p.y) * 0.3 * dt;
        }
        if (t < G3 && px > -999) {
          const dx = p.x - px, dy = p.y - py, d2 = dx * dx + dy * dy, R = 90;
          if (d2 < R * R) { const d = Math.sqrt(d2) || 1; p.y += (dy / d) * (R - d) * 0.09 * dt; p.x += (dx / d) * (R - d) * 0.02 * dt; }
        }
        if (p.y < H * 0.08) p.y = H * 0.08; else if (p.y > H * 0.96) p.y = H * 0.96;
        p.x += p.v * sp * dt;
        if (p.x > W + 12) P[i] = spawn();
      }
    };

    const draw = () => {
      ctx.clearRect(0, 0, W, H);
      // lanes
      ctx.lineWidth = 1;
      if (laneGrad) ctx.strokeStyle = laneGrad;
      ctx.beginPath();
      for (const y of laneY) { ctx.moveTo(W * G2, y + 0.5); ctx.lineTo(W, y + 0.5); }
      ctx.stroke();
      // gates
      ctx.setLineDash([3, 5]);
      for (const [g, c] of [[G1, 'rgba(20,20,18,0.22)'], [G2, 'rgba(20,20,18,0.22)'], [G3, SIG]] as const) {
        ctx.strokeStyle = c; ctx.globalAlpha = g === G3 ? 0.7 : 1;
        ctx.beginPath(); ctx.moveTo(Math.round(W * g) + 0.5, 22); ctx.lineTo(Math.round(W * g) + 0.5, H * 0.97); ctx.stroke();
      }
      ctx.setLineDash([]); ctx.globalAlpha = 1;
      // particles, bucketed by style
      ctx.fillStyle = INK;
      for (const p of P) {
        if (p.dead) continue;
        const t = p.x / W;
        if (t >= G3) continue;
        ctx.globalAlpha = t < G1 ? 0.42 : 0.42 + 0.5 * ((t - G1) / (G3 - G1));
        ctx.fillRect(p.x, p.y, 2, 2);
      }
      ctx.globalAlpha = 0.9; ctx.strokeStyle = INK; ctx.lineWidth = 1.4; ctx.beginPath();
      for (const p of P) {
        if (p.dead || p.x / W < G3) continue;
        const len = 4 + p.v * 9;
        ctx.moveTo(p.x - len, p.y); ctx.lineTo(p.x, p.y);
      }
      ctx.stroke();
      ctx.fillStyle = SIG;
      for (const p of P) {
        if (!p.dead) continue;
        ctx.globalAlpha = Math.max(0, p.a);
        ctx.fillRect(p.x - 1.2, p.y - 1.2, 2.6, 2.6);
      }
      ctx.globalAlpha = 1;
    };

    let tick = 0, lastScroll = -1e9;
    addEventListener('scroll', () => { lastScroll = performance.now(); }, { passive: true });
    const loop = (now: number) => {
      if (!running) return;
      const dt = Math.min(2.5, last ? (now - last) / 16.67 : 1); last = now;
      // While the page is scrolling, render the field at half rate: scrolling gets the frame budget.
      if (now - lastScroll < 180 && (tick & 1)) { tick++; requestAnimationFrame(loop); return; }
      step(dt); draw();
      if (++tick % 24 === 0) for (const k of ['seen', 'pass', 'held'] as const) out[k] && (out[k].textContent = counts[k].toLocaleString('en-US'));
      requestAnimationFrame(loop);
    };
    const play = () => { if (reduce || running || !visible || document.hidden) return; running = true; last = 0; requestAnimationFrame(loop); };
    const pause = () => { running = false; };

    new ResizeObserver(() => { resize(); if (!reduce) draw(); }).observe(root);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting && e.intersectionRatio > 0.2; visible ? play() : pause(); }, { threshold: [0, 0.2, 0.5] }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    root.addEventListener('pointermove', (e) => { const r = root.getBoundingClientRect(); px = e.clientX - r.left; py = e.clientY - r.top; });
    root.addEventListener('pointerleave', () => { px = -999; py = -999; });
    if (reduce) root.querySelector('.signal-readout')?.setAttribute('hidden', '');
  }
</script>
