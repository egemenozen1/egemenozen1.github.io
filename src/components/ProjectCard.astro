---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
const { title, category, summary, problem, approach, verifiedOutput, technologies, sourceUrl, liveUrl } = project.data;
---
<article class={`project ${index === 1 ? 'project--lead' : index === 4 ? 'project--wide' : 'project--compact'}`}>
  <div class="project-intro">
    <span class="project-index">{String(index).padStart(2, '0')} / 04 &nbsp;·&nbsp; {category}</span>
    <h3><a class="project-title-link" href={`/projects/${project.id}/`} aria-label={`${title} — View case study`}>{title}</a></h3>
    <p class="project-summary">{summary}</p>
    <div class="tech-list">{technologies.map((t) => <span class="tech">{t}</span>)}</div>
    <div class="link-row">
      <a class="text-link project-open-label" href={`/projects/${project.id}/`}>View case study <span aria-hidden="true">↗</span></a>
      {sourceUrl && <a class="text-link" href={sourceUrl} rel="noopener noreferrer" target="_blank">Source <span aria-hidden="true">↗</span></a>}
      {liveUrl && <a class="text-link" href={liveUrl} rel="noopener noreferrer" target="_blank">Live app <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
  <ProjectVisual id={project.id} />
  <dl class="project-evidence">
    <div><dt>Problem</dt><dd>{problem}</dd></div>
    <div><dt>Approach / solution</dt><dd>{approach}</dd></div>
    <div><dt>Verified output</dt><dd>{verifiedOutput}</dd></div>
  </dl>
</article>
