---
// Condensed replay of a recorded EGO AI Studio coordination test (November 2026).
// Roles and outcomes come from the office's own status log; timing is compressed.
const crew = [
  { id: 'research', role: 'Research', name: 'Market intelligence' },
  { id: 'engineer', role: 'Engineering', name: 'Software engineer' },
  { id: 'ux', role: 'Product & UX', name: 'Design review' },
  { id: 'qa', role: 'QA & Security', name: 'Read-only reviewer' },
  { id: 'data', role: 'Data & Automation', name: 'Pipelines, n8n' },
  { id: 'career', role: 'Career', name: 'Jobs & skills' },
];
const steps = [
  { who: 'owner', at: 'owner', tone: 'sig', text: '/office "integrity check for the status command"' },
  { who: 'director', at: 'director', tone: '', text: 'plan: research → engineering → QA · gate: all suites pass' },
  { who: 'research', at: 'research', tone: '', text: 'sourced answer + "verify first" list' },
  { who: 'director', at: 'director', tone: 'ok', text: 'key claim checked against official docs ✓' },
  { who: 'engineer', at: 'engineer', tone: '', text: 'implements roster-vs-definitions check' },
  { who: 'director', at: 'director', tone: 'ok', text: '7 suites run → 118 tests passed' },
  { who: 'qa', at: 'qa', tone: 'warn', text: 'read-only review: 0 blockers, 3 minor findings' },
  { who: 'engineer', at: 'engineer', tone: 'ok', text: '3 findings fixed + new regression test' },
  { who: 'gate', at: 'gate', tone: 'warn', text: 'irreversible step held → awaiting owner' },
];
---
<div class="instrument mission" data-mission>
  <div class="instrument-bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>mission replay · recorded coordination test</span>
    <button class="mini-btn" type="button" data-replay hidden>Replay ↻</button>
  </div>
  <div class="mission-board">
    <div class="mission-top">
      <div class="node node-owner" data-node="owner"><small>Owner</small><b>Egemen</b></div>
      <div class="mission-wire" aria-hidden="true"></div>
      <div class="node node-director" data-node="director"><small>Director</small><b>Main session</b></div>
    </div>
    <ul class="crew" role="list" aria-label="Six specialist agents">
      {crew.map((c) => <li class="node" data-node={c.id}><small>{c.role}</small><b>{c.name}</b></li>)}
    </ul>
    <div class="node node-gate" data-node="gate"><div><small>Human gate</small><b>Send · publish · buy · push</b></div><span class="gate-lock" aria-hidden="true">owner only</span></div>
  </div>
  <ol class="mission-log" role="list" aria-label="Mission log">
    {steps.map((s, i) => <li class={s.tone} data-step={s.at}><span>{`step ${String(i + 1).padStart(2, '0')}`}</span><span>{s.who.padEnd(8, ' ')} {s.text}</span></li>)}
  </ol>
  <p class="instrument-note">Condensed replay of a recorded run. Specialists never call each other — every hand-off goes through the Director. Three of six specialists were needed for this objective.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-mission]').forEach((root) => {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const nodes = new Map([...root.querySelectorAll<HTMLElement>('[data-node]')].map((node) => [node.dataset.node, node]));
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]');
    const board = root.querySelector('.mission-board');
    if (!replay || !board || !('IntersectionObserver' in window)) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0, next = steps.length, visible = false, played = false;
    const pause = () => { clearTimeout(timer); timer = 0; };
    const resetNodes = () => {
      root.dataset.phase = '';
      for (const node of nodes.values()) node.classList.remove('is-active', 'is-done', 'is-held');
    };
    const schedule = () => {
      if (!timer && visible && !document.hidden && !reduce.matches && next < steps.length) {
        timer = window.setTimeout(show, 1150);
      }
    };
    const show = () => {
      timer = 0;
      const step = steps[next];
      const previous = steps[next - 1]?.dataset.step;
      for (const node of nodes.values()) node.classList.remove('is-active');
      if (previous !== 'director' && previous !== 'owner') nodes.get(previous)?.classList.add('is-done');
      nodes.get(step.dataset.step)?.classList.add(step.dataset.step === 'gate' ? 'is-held' : 'is-active');
      if (next === 1) root.dataset.phase = 'brief';
      step.hidden = false;
      next++;
      if (next === steps.length) nodes.get('director')?.classList.add('is-done');
      else schedule();
    };
    const run = () => {
      if (reduce.matches) return;
      played = true;
      pause();
      resetNodes();
      root.dataset.replaying = '';
      steps.forEach((step) => { step.hidden = true; });
      next = 0;
      show();
    };
    const sync = () => {
      replay.hidden = reduce.matches;
      root.toggleAttribute('data-replay-paused', !visible || document.hidden);
      if (reduce.matches) {
        pause();
        resetNodes();
        delete root.dataset.replaying;
        steps.forEach((step) => { step.hidden = false; });
        next = steps.length;
        nodes.get('gate')?.classList.add('is-held');
      } else if (document.hidden || !visible) pause();
      else if (!played) run();
      else schedule();
    };
    replay.addEventListener('click', run);
    reduce.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(board);
    sync();
  });
</script>
