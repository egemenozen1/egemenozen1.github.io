---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCanvas from '../components/StoryCanvas.astro';
import HorizonExplorer from '../components/HorizonExplorer.astro';
import { site } from '../config/site';
import { forecast } from '../data/forecast';
import mpShot from '../assets/work/ictavo-week.png';
import fmShot from '../assets/work/futureme-home.png';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const get = (id: string) => all.find((p) => p.id === id)!;
const tft = get('pytorch-forecasting-tft');
const smalls = [get('recommendation-systems'), get('antidepressant-binding-mechanisms')];

const name = [['E', 'g', 'e', 'm', 'e', 'n'], ['Ö', 'z', 'e', 'n', '.']];
let ci = 0;

const steps = [
  { theme: 'lab', yr: '2017 — 2023 · Istanbul', h: 'It started in a genetics lab.', p: 'BSc Genetics & Bioengineering at Istanbul Bilgi University. Bioinformatics, statistics, genetic data in R — and one habit that stuck: before you believe a result, ask for the control group.',
    proof: [['senior design', 'molecular docking of ten compounds against two transporter structures'], ['the lesson', 'a computational score is not a clinical result — so the numbers stay out of the portfolio']] },
  { theme: 'data', yr: '2023 — 2024 · Berlin', h: 'Then the strands became data.', p: 'MSc Data Analytics at BSBI Berlin. Machine learning, deep learning, NLP — and the discipline of measuring a model against something simpler before trusting it.',
    proof: [['tft experiment', '7.8% lower average error than persistence'], ['and the catch', `its 80% interval covered only 43.3% — ${forecast.persistenceResult.toLowerCase()}`], ['thesis', 'recommendation systems with SQL & AI for smaller businesses']] },
  { theme: 'agents', yr: '2026 · now', h: 'Now the data has agents.', p: 'I build AI systems end to end and run EGO AI Studio — an independent AI automation practice operated by a human-governed agent office I designed: one Director, six specialists, quality gates and an owner on everything irreversible.',
    proof: [['recorded run', 'research → engineering → QA · 118 tests passed · push held for the owner'], ['rule', 'specialists never call each other; every hand-off goes through the Director']] },
];

const cards = [
  { p: get('ego-ai-studio'), bg: '#111113', fg: '#f2f2f0', media: 'ego' },
  { p: get('ictavo'), bg: '#0b1630', fg: '#eaf0fa', media: 'mp' },
  { p: get('futureme-ai'), bg: '#ffb079', fg: '#0f0d1a', media: 'fm' },
];

const tools = ['Python', 'Claude API', 'FastAPI', 'n8n', 'SQL', 'React', 'TypeScript', 'Gemini API', 'PyTorch Forecasting', 'Docker', 'pandas', 'GitHub Actions', 'R', 'SQLite', 'Claude Code agents'];
const rules = [
  ['Function before effect.', 'Who uses it, and why — before any animation.', 'Like this page: static, no trackers, no cookies.'],
  ['Beat a baseline first.', 'A model earns its complexity against something simple.', 'TFT vs persistence, losses included.'],
  ['Every number keeps its receipt.', 'Source, time and sample flag — or the value stays empty.', 'Ictavo: missing stays missing.'],
  ['People own the irreversible.', 'Agents research, draft, build and test. Humans send, publish, buy and push.', 'EGO AI Studio’s owner gate.'],
];
---
<BaseLayout>
  <section class="intro wrap" data-theme-section="bone" aria-labelledby="hero-title">
    <div class="intro-top">
      <p class="eyebrow">Portfolio · 2026 · Berlin</p>
      <p class="eyebrow">AI Engineer &amp; Data Analyst</p>
      <p class="eyebrow">Open to Applied AI roles &amp; EU projects</p>
    </div>
    <h1 class="kinetic" id="hero-title" data-kinetic aria-label="Egemen Özen">
      {name.map((ln) => <span class="ln" aria-hidden="true">{ln.map((c) => <span class="ch" style={`--i:${ci++}`}>{c}</span>)}</span>)}
    </h1>
    <div class="intro-foot">
      <p class="lede">Bioengineer turned AI engineer. I build agent workflows, automations and data products — and I treat every model like an experiment: with a control, a baseline and a written limit.</p>
      <div class="meta"><span><b>MSc</b> Data Analytics · Berlin</span><span><b>BSc</b> Genetics &amp; Bioengineering · Istanbul</span><span><b>TR · EN C1 · DE C1</b></span></div>
      <a class="scroll-cue" href="#story"><i aria-hidden="true">↓</i>Follow the thread</a>
    </div>
  </section>

  <section class="wrap story" id="story" aria-label="From DNA to agents: my path in three chapters">
    <div class="story-steps" data-steps>
      {steps.map((s, i) => (
        <article class="step" data-theme-section={s.theme} aria-labelledby={`step-${i}`}>
          <p class="yr">{String(i + 1).padStart(2, '0')} · {s.yr}</p>
          <h2 id={`step-${i}`}>{s.h}</h2>
          <p>{s.p}</p>
          <ul class="proof" role="list">{s.proof.map(([k, v]) => <li><b>{k}</b> — {v}</li>)}</ul>
        </article>
      ))}
    </div>
    <StoryCanvas />
  </section>

  <section class="section wrap" id="work" data-theme-section="bone" aria-labelledby="work-title">
    <h2 class="sec-title" id="work-title" data-reveal><small>What I’ve built</small>Three systems, <em>three proofs.</em></h2>
    <div class="stack">
      {cards.map(({ p, bg, fg, media }, i) => {
        const v = p.data.evidence.find((e) => e.state === 'verified' || e.state === 'live');
        const lim = p.data.evidence.find((e) => e.state === 'limit' || e.state === 'private');
        return (
          <article class="pcard" style={`--i:${i};--c-bg:${bg};--c-fg:${fg}`} data-pcard aria-labelledby={`card-${p.id}`}>
            <span class="dim" aria-hidden="true"></span>
            <div>
              <p class="num">0{i + 1} / {p.data.category} · {p.data.year}</p>
              <h3 id={`card-${p.id}`} style={`view-transition-name: t-${p.id}`}><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
              <p class="thesis">{p.data.thesis}</p>
              <ul class="facts" role="list">
                <li><span>Role</span>{p.data.role}</li>
                <li><span>Stack</span>{p.data.technologies.slice(0, 5).join(' · ')}</li>
                {v && <li><span>Proof</span>{v.text}</li>}
                {lim && <li><span>Limit</span>{lim.text}</li>}
              </ul>
              <div class="acts">
                <a href={`/projects/${p.id}/`}>Case study →</a>
                {p.data.liveUrl && <a href={p.data.liveUrl} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}
              </div>
            </div>
            {media === 'ego' && (
              <div class="media ego" aria-label="EGO AI Studio office structure">
                <div class="ego-net">
                  <span class="wide">owner <b>Egemen</b></span>
                  <span class="wide">director <b>Main session</b></span>
                  {['Research', 'Engineering', 'Product & UX', 'QA & Security', 'Data & Automation', 'Career'].map((r) => <span>specialist<b>{r}</b></span>)}
                  <span class="wide gate">human gate <b>send · publish · buy · push</b></span>
                </div>
              </div>
            )}
            {media === 'mp' && <div class="media fit" style="--fit:#ffbea2"><Image src={mpShot} widths={[640, 1000]} sizes="(max-width: 1000px) 92vw, 50vw" quality={76} loading="lazy" alt="Ictavo: “A heavy week. 59 of 73 fell.” with an hourly market line. Sample portfolio." /></div>}
            {media === 'fm' && <div class="media fit" style="--fit:#0f0d1a"><Image src={fmShot} widths={[640, 1000]} sizes="(max-width: 1000px) 92vw, 50vw" quality={76} loading="lazy" alt="FutureMe: “Decide today. Find out who was right.” with a fork diagram of options and dated predictions." /></div>}
          </article>
        );
      })}
    </div>
  </section>

  <section class="section wrap" id="lab" data-theme-section="bone" aria-labelledby="lab-title">
    <h2 class="sec-title" id="lab-title" data-reveal><small>From the lab</small>Experiments, <em>failures included.</em></h2>
    <div class="lab-row">
      <article class="lab-card big" data-reveal>
        <HorizonExplorer />
        <div class="in">
          <p class="eyebrow">{tft.data.category} · {tft.data.year}</p>
          <h3 style="view-transition-name: t-pytorch-forecasting-tft"><a href={`/projects/${tft.id}/`}>{tft.data.thesis}</a></h3>
        </div>
      </article>
      <div class="lab-side">
        {smalls.map((p, i) => (
          <article class="lab-card" data-reveal style={`--d:${(i + 1) * 100}ms`}>
            <p class="eyebrow">{p.data.category} · {p.data.year}</p>
            <h3 style={`view-transition-name: t-${p.id}`}><a href={`/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.thesis}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="marquee" aria-label={`Toolkit: ${tools.join(', ')}`} role="img">
    <div class="marquee-track" data-marquee aria-hidden="true">{[...tools, ...tools].map((t) => <span>{t}</span>)}</div>
  </div>

  <section class="section wrap" id="approach" data-theme-section="bone" aria-labelledby="rules-title">
    <h2 class="sec-title" id="rules-title" data-reveal><small>How I work</small>Four rules, <em>no exceptions.</em></h2>
    <ol class="rules" role="list">
      {rules.map(([h, p, proof]) => <li class="rule" data-reveal><h3>{h}</h3><p>{p} <b>{proof}</b></p></li>)}
    </ol>
  </section>

  <section class="section wrap" id="studio" data-theme-section="bone" aria-labelledby="doors-title">
    <h2 class="sec-title" id="doors-title" data-reveal><small>Two doors</small>Hire me, <em>or hand me a process.</em></h2>
    <div class="doors" id="about">
      <article class="door hire" data-reveal>
        <p class="eyebrow">For teams hiring</p>
        <h3>An AI engineer with a scientist’s habits.</h3>
        <ul role="list">
          <li>Applied AI &amp; automation — agent roles, quality gates, Claude &amp; Gemini integrations, n8n</li>
          <li>Data depth — MSc Data Analytics, forecasting evaluated against honest baselines</li>
          <li>Product end to end — a live public demo and a full local product, UI to database</li>
          <li>Berlin-based · German &amp; English C1 · Turkish native</li>
        </ul>
        <a class="btn" href="#contact">Talk about a role →</a>
      </article>
      <article class="door biz" data-reveal style="--d:100ms">
        <p class="eyebrow">For businesses · EGO AI Studio</p>
        <h3>Automation that keeps working after I leave.</h3>
        <ul role="list">
          <li>Document &amp; invoice automation — uncertain items go to a review list, not a guess</li>
          <li>Website assistants that answer from your content and can say “I don’t know”</li>
          <li>Data &amp; reporting automation with checks before numbers reach your team</li>
          <li>Agent workflows with an approval gate on anything that leaves the building</li>
        </ul>
        <a class="btn btn-ghost" href="#contact">Describe your process →</a>
      </article>
    </div>
    <dl class="facts-strip" data-reveal>
      <div><dt>Education</dt><dd>MSc Data Analytics — BSBI Berlin<small>2023 — 2024</small></dd></div>
      <div><dt>&nbsp;</dt><dd>BSc Genetics & Bioengineering — Istanbul Bilgi University<small>2017 — 2023</small></dd></div>
      <div><dt>Languages</dt><dd>Turkish · English C1 · German C1</dd></div>
      <div><dt>Based in</dt><dd>Berlin, Germany<small>remote across the EU</small></dd></div>
    </dl>
  </section>

  <section class="contact wrap" id="contact" data-theme-section="cobalt" aria-labelledby="contact-title">
    <p class="eyebrow">Contact</p>
    <h2 class="talk" id="contact-title" data-kinetic aria-label="Let’s talk."><span aria-hidden="true">{[...'Let’s talk.'].map((c) => c === ' ' ? ' ' : <span class="ch">{c}</span>)}</span></h2>
    <div class="contact-row">
      <p>For Applied AI, automation or data roles — or a process in your business that should run itself. I reply in English, German or Turkish.</p>
      <div class="reach">
        <p class="eyebrow">Email</p>
        <p class="mail"><a href={`mailto:${site.email}`} data-mail>{site.email}</a></p>
        <div class="contact-actions">
          <button class="btn" type="button" data-copy={site.email}>Copy email</button>
          <a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a class="btn btn-ghost" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
        <p class="copy-state" role="status" data-copy-state></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');
  const root = document.documentElement;

  // Chapter colours: whichever section crosses the middle of the viewport sets the theme.
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) root.dataset.theme = (entry.target as HTMLElement).dataset.themeSection;
      }
    }, { rootMargin: '-50% 0px -50% 0px' });
    document.querySelectorAll('[data-theme-section]').forEach((section) => io.observe(section));

    const track = document.querySelector<HTMLElement>('[data-marquee]');
    const work = document.getElementById('work');
    const wide = matchMedia('(min-width: 1001px)');
    const pending = new Set([work, track].filter((element): element is HTMLElement => !!element));
    const near = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || !motion.matches || !pending.has(entry.target as HTMLElement)) continue;
        const target = entry.target as HTMLElement;
        near.unobserve(target);
        pending.delete(target);
        void import('../scripts/home-motion').then(({ animateCards, animateMarquee }) => {
          if (target === track) animateMarquee(track);
          else animateCards(target);
        }).catch(() => { /* Native scrolling and static content still work if the optional chunk fails. */ });
      }
    }, { rootMargin: '400px 0px' });
    const watch = () => {
      near.disconnect();
      if (motion.matches) for (const target of pending) {
        if (target === track || wide.matches) near.observe(target);
      }
    };
    motion.addEventListener('change', watch);
    wide.addEventListener('change', watch);
    watch();
  }

  // Measure all letters before changing font axes to avoid interleaving layout reads and writes.
  const kinetic = matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)');
  document.querySelectorAll<HTMLElement>('[data-kinetic]').forEach((el) => {
    const chars = [...el.querySelectorAll<HTMLElement>('.ch')];
    let frame = 0;
    let x = 0, y = 0;
    const clear = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      for (const char of chars) {
        char.style.removeProperty('--w');
        char.style.removeProperty('--wd');
      }
    };
    const apply = () => {
      frame = 0;
      const proximity = chars.map((char) => {
        const rect = char.getBoundingClientRect();
        return Math.max(0, 1 - Math.hypot(x - rect.left - rect.width / 2, y - rect.top - rect.height / 2) / 420);
      });
      chars.forEach((char, i) => {
        char.style.setProperty('--w', String(Math.round(800 - 500 * proximity[i])));
        char.style.setProperty('--wd', String(Math.round(100 - 25 * proximity[i])));
      });
    };
    el.addEventListener('pointermove', (event) => {
      if (!kinetic.matches) return;
      x = event.clientX;
      y = event.clientY;
      if (!frame) frame = requestAnimationFrame(apply);
    });
    el.addEventListener('pointerleave', clear);
    kinetic.addEventListener('change', clear);
  });

  // Copy email: clipboard first; if that is blocked, select the address so Ctrl+C works.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]'), state = document.querySelector('[data-copy-state]'), mail = document.querySelector<HTMLElement>('[data-mail]');
  copy?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(copy.dataset.copy || ''); copy.textContent = 'Copied ✓'; state!.textContent = 'Email copied — paste it into any mail app.'; setTimeout(() => (copy.textContent = 'Copy email'), 2400); }
    catch { if (mail) { const r = document.createRange(); r.selectNodeContents(mail); const sel = getSelection(); sel?.removeAllRanges(); sel?.addRange(r); } state!.textContent = 'Address selected — press Ctrl+C (⌘C) to copy.'; }
  });
</script>
