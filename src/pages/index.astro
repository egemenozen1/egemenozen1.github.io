---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout>
  <Hero />
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-label">01 / Selected work</div>
      <h2 class="section-heading" id="work-title">Work you can inspect.</h2>
      <p class="section-desc">Four projects across product building, forecasting and research. Each one shows the question, the method and what the available evidence actually supports.</p>
      <div class="projects">{projects.map((p,i) => <ProjectCard project={p} index={i+1}/>)}</div>
    </div>
  </section>
  <section class="section" id="expertise" aria-labelledby="expertise-title">
    <div class="container">
      <div class="section-label">02 / Expertise</div>
      <h2 class="section-heading" id="expertise-title">Where analysis meets execution.</h2>
      <div class="expertise-grid">
        <div class="expertise"><div class="expertise-no">01 / ANALYTICS</div><h3>Data & Analytics</h3><p>Python, SQL, data exploration, statistical reasoning and visualization. From noisy inputs to useful insights.</p><a class="expertise-link" href="/projects/recommendation-systems/">Explore SQL research <span aria-hidden="true">↗</span></a></div>
        <div class="expertise"><div class="expertise-no">02 / INTELLIGENCE</div><h3>Applied AI</h3><p>Machine learning fundamentals, experimentation, model comparison and evaluation grounded in evidence.</p><a class="expertise-link" href="/projects/pytorch-forecasting-tft/">Explore forecasting work <span aria-hidden="true">↗</span></a></div>
        <div class="expertise"><div class="expertise-no">03 / EXECUTION</div><h3>Product Building</h3><p>Prototyping, API-driven applications, testing and iterative product improvement with attention to usability.</p><a class="expertise-link" href="/projects/futureme-ai/">Explore product work <span aria-hidden="true">↗</span></a></div>
      </div>
    </div>
  </section>
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container about-grid">
      <div><div class="section-label">03 / Background</div><h2 class="section-heading" id="about-title">Scientific roots. Product-minded execution.</h2><p class="section-desc">My studies in Genetics & Bioengineering at Istanbul Bilgi University and Data Analytics at BSBI Berlin shape how I approach problems: question assumptions, work with evidence and make ideas tangible.</p><p class="section-desc">I am focused on opportunities at the intersection of data analytics, applied AI and technical product development.</p></div>
      <div class="facts"><div class="fact"><span>Based in</span><strong>Berlin, Germany</strong></div><div class="fact"><span>Education</span><strong>MSc Data Analytics — BSBI Berlin<br />BSc Genetics & Bioengineering — Istanbul Bilgi University</strong></div><div class="fact"><span>Areas</span><strong>Data / AI / Software products</strong></div></div>
    </div>
  </section>
  <section class="section" id="contact" aria-labelledby="contact-title"><div class="container contact-area"><div><div class="section-label">04 / Contact</div><h2 class="contact-heading" id="contact-title">Let's make something useful.</h2><p class="section-desc">For roles and collaborations in analytics, applied AI or product development, email me directly or explore the source behind my work.</p></div><div class="contact-links"><a href={`mailto:${site.email}`}><span><small>Email</small>{site.email}</span><span aria-hidden="true">↗</span></a><a href={site.github} target="_blank" rel="noopener noreferrer"><span><small>Code & projects</small>GitHub profile</span><span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
