---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { providerAddress } from '../config/legal';
---
<BaseLayout title="Impressum — Egemen Özen" description="Provider information for Egemen Özen's portfolio.">
  <section class="wrap page-simple" aria-labelledby="impressum-title">
    <a class="crumb eyebrow" href="/">← Home</a>
    <p class="eyebrow">Legal notice</p>
    <h1 class="case-title" id="impressum-title">Impressum</h1>
    <div class="legal">
      <section aria-labelledby="provider-title">
        <h2 id="provider-title">Provider</h2>
        <address>{site.name}<br />{providerAddress.map((line) => <>{line}<br /></>)}</address>
      </section>
      <section aria-labelledby="contact-title">
        <h2 id="contact-title">Contact</h2>
        <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </section>
    </div>
  </section>
</BaseLayout>
