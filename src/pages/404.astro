---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — Egemen Özen" description="The page you requested could not be found." noindex>
  <section class="case-hero not-found" aria-labelledby="not-found-title">
    <div class="container">
      <div class="section-label">404 / Page not found</div>
      <h1 id="not-found-title">This page doesn't exist.</h1>
      <p class="case-subtitle">The link may have changed. Return to the homepage to explore the projects.</p>
      <div class="actions"><a class="btn btn-primary" href="/">Back to homepage <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>
</BaseLayout>
