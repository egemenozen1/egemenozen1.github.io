---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceLedger from '../../components/EvidenceLedger.astro';
import MissionReplay from '../../components/MissionReplay.astro';
import HorizonExplorer from '../../components/HorizonExplorer.astro';
import { forecast } from '../../data/forecast';
import fmExample from '../../assets/work/futureme-example.png';
import fmRecord from '../../assets/work/futureme-record.png';
import mpWhy from '../../assets/work/ictavo-why.png';
import mpInsights from '../../assets/work/ictavo-insights.png';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({ params: { id: project.id }, props: { project, next: projects[(i + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isForecast = project.id === 'pytorch-forecasting-tft';
const evidence = isForecast
  ? [...d.evidence, { state: 'limit' as const, text: `${forecast.persistenceResult}. Single-site experiment; training was not re-run for this portfolio.` }]
  : d.evidence;
const long = d.title.length > 34;
---
<BaseLayout title={`${d.title} — Egemen Özen`} description={d.summary}>
  <article>
    <header class="wrap case-hero">
      <a class="crumb eyebrow" href={d.flagship ? '/#work' : '/#lab'}>← {d.flagship ? 'What I’ve built' : 'From the lab'}</a>
      <p class="eyebrow">{d.category} · {d.year}</p>
      <h1 class={`case-title${long ? ' long' : ''}`} style={`view-transition-name: t-${project.id}`}>{d.title}</h1>
      <p class="case-thesis">{d.thesis}</p>
      <dl class="case-facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Status</dt><dd>{d.status}</dd></div>
        <div><dt>Disciplines</dt><dd>{d.disciplines.join(' · ')}</dd></div>
        <div><dt>Links</dt><dd>
          {d.liveUrl && <a class="link-arrow" href={d.liveUrl} target="_blank" rel="noopener noreferrer">Live demo <span class="ar" aria-hidden="true">↗</span></a>}
          {d.sourceUrl && <a class="link-arrow" href={d.sourceUrl} target="_blank" rel="noopener noreferrer">Source <span class="ar" aria-hidden="true">↗</span></a>}
          {!d.liveUrl && !d.sourceUrl && <span>No public link — see the ledger</span>}
        </dd></div>
      </dl>
    </header>

    <div class="wrap">
      {project.id === 'ego-ai-studio' && <div class="case-stage"><MissionReplay /></div>}
      {isForecast && <div class="case-stage card"><HorizonExplorer /></div>}
      {d.cover && (
        <figure class="case-cover">
          <div class="frame"><Image src={d.cover} alt={d.coverAlt ?? ''} widths={[720, 1080, 1440, 2000]} sizes="(max-width: 1480px) 100vw, 1360px" quality={80} loading="eager" /></div>
          {d.coverCaption && <figcaption>{d.coverCaption}</figcaption>}
        </figure>
      )}
    </div>

    <div class="wrap case-layout">
      <aside class="case-aside" aria-label="Project evidence and stack">
        <EvidenceLedger items={evidence} />
        <div>
          <p class="eyebrow" style="margin-bottom:10px">Stack</p>
          <ul class="chips" role="list">{d.technologies.map((t) => <li>{t}</li>)}</ul>
        </div>
      </aside>
      <div class="prose">
        <Content />
        {project.id === 'futureme-ai' && (
          <>
            <figure class="case-cover">
              <div class="frame"><Image src={fmExample} alt="The fictional worked example: a fork with the chosen road and scored predictions, the four stages ticked, and “What actually happened?”." widths={[720, 1080, 1440]} sizes="(max-width: 1080px) 100vw, 60vw" quality={78} loading="lazy" /></div>
              <figcaption>The worked example after scoring. Fictional data.</figcaption>
            </figure>
            <figure class="case-cover">
              <div class="frame"><Image src={fmRecord} alt="Track record of the fictional example: Brier score 0.30 marked as too early to read, said versus happened 70% against 67%, an honesty curve and estimates versus reality." widths={[720, 1080, 1440]} sizes="(max-width: 1080px) 100vw, 60vw" quality={78} loading="lazy" /></div>
              <figcaption>Track record: the score says when it is too early to read. Fictional data.</figcaption>
            </figure>
          </>
        )}
        {project.id === 'ictavo' && (
          <>
            <figure class="case-cover">
              <div class="frame"><Image src={mpWhy} alt="The Why? screen: “Why did Chainlink rise?” with its 7-day change against Bitcoin and the typical asset, and the first suspected cause stamped Doesn't fit." widths={[720, 1080, 1440]} sizes="(max-width: 1080px) 100vw, 60vw" quality={78} loading="lazy" /></div>
              <figcaption>Why?: explanations tested one by one. Sample portfolio.</figcaption>
            </figure>
            <figure class="case-cover">
              <div class="frame"><Image src={mpInsights} alt="What the week hid: cards with the holdings change against the market, the worst and best hours, and assets that moved against the crowd." widths={[720, 1080, 1440]} sizes="(max-width: 1080px) 100vw, 60vw" quality={78} loading="lazy" /></div>
              <figcaption>What the week hid: measured facts, each linking to the evidence.</figcaption>
            </figure>
          </>
        )}
      </div>
    </div>

    <nav class="wrap next-case" aria-label="Next project">
      <a href={`/projects/${next.id}/`}>
        <span class="eyebrow">Next · {next.data.category}</span>
        <span class="t">{next.data.title} →</span>
      </a>
    </nav>
  </article>
</BaseLayout>
